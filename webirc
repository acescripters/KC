    }
    if (info.whois.realname) {
      html += `<div class="whois-line"><span class="whois-label">Realname:</span> ${info.whois.realname}</div>`;
    }
    if (info.server) {
      html += `<div class="whois-line"><span class="whois-label">Server:</span> ${info.server}</div>`;
    }
    if (info.account) {
      html += `<div class="whois-line"><span class="whois-label">Account:</span> ${info.account}</div>`;
    }
    if (info.idle) {
      const idleMin = Math.floor(parseInt(info.idle) / 60);
      html += `<div class="whois-line"><span class="whois-label">Idle:</span> ${idleMin} minutes</div>`;
