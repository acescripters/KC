// ====== UTILITY FUNCTIONS ======
function formatTime() {
  const now = new Date();
  return now.toLocaleTimeString('en-US', { 
    hour12: true, 
    hour: '2-digit', 
    minute: '2-digit',
    second: '2-digit'
  }).toLowerCase();
}

function updateTime() {
  document.getElementById('currentTime').textContent = formatTime();
}
setInterval(updateTime, 1000);
updateTime();

function parseNickPrefix(nick) {
  const prefixes = {
    '~': { class: 'owner', display: '~', title: 'Channel Owner' },
    '&': { class: 'admin', display: '&', title: 'Channel Admin' },
    '@': { class: 'op', display: '@', title: 'Channel Operator' },
    '%': { class: 'half-op', display: '%', title: 'Half-Operator' },
    '+': { class: 'voice', display: '+', title: 'Voiced User' }
  };

  for (const [prefix, info] of Object.entries(prefixes)) {
    if (nick.startsWith(prefix)) {
      return {
        prefix: prefix,
        class: info.class,
        display: info.display,
        title: info.title,
        cleanNick: nick.substring(1)
      };
    }
  }

  return {
    prefix: '',
    class: '',
    display: '',
    title: 'Normal User',
    cleanNick: nick
  };
}

function addChatMessage(type, nick, message, userHost = '', rawMessage = '') {
  const container = document.getElementById('chatContent');
  const msgDiv = document.createElement('div');

  msgDiv.className = 'chat-message';
  if (type === 'system' || type === 'join' || type === 'part' || type === 'quit') {
    msgDiv.classList.add('system');
    if (type === 'join' || type === 'part' || type === 'quit') {
      msgDiv.classList.add('join-part');
    }
  } else if (type === 'pm') {
    msgDiv.classList.add('pm');
  } else if (type === 'me') {
    msgDiv.classList.add('me');
  }

  const timeSpan = document.createElement('span');
  timeSpan.className = 'message-time';
  timeSpan.textContent = formatTime();

  msgDiv.appendChild(timeSpan);

  if (type === 'system') {
    msgDiv.innerHTML += message;
  } else if (type === 'whois') {
    // Display WHOIS info in a box
    const whoisBox = document.createElement('div');
    whoisBox.className = 'whois-box';
    whoisBox.innerHTML = message;
    msgDiv.appendChild(whoisBox);
  } else if (type === 'join') {
    msgDiv.innerHTML = `* Joins: ${nick} (${userHost})`;
  } else if (type === 'part') {
    msgDiv.innerHTML = `* Parts: ${nick} (${userHost})`;
  } else if (type === 'quit') {
    msgDiv.innerHTML = `* Quits: ${nick} (${userHost})`;
  } else if (type === 'me') {
    const nickSpan = document.createElement('span');
    nickSpan.className = 'message-nick';
    nickSpan.textContent = `${nick}: `;
    msgDiv.appendChild(nickSpan);
    msgDiv.appendChild(document.createTextNode(message));
  } else if (type === 'pm') {
    const nickSpan = document.createElement('span');
    nickSpan.className = 'message-nick';
    nickSpan.textContent = `${nick} (PM): `;
    msgDiv.appendChild(nickSpan);

    const messageSpan = document.createElement('span');
    messageSpan.innerHTML = message || rawMessage;
    msgDiv.appendChild(messageSpan);
  } else {
    const nickInfo = parseNickPrefix(nick);
    const nickSpan = document.createElement('span');
    nickSpan.className = 'message-nick';
    if (nickInfo.class) {
      nickSpan.innerHTML = `<span class="nick-prefix ${nickInfo.class}" title="${nickInfo.title}">${nickInfo.display}</span>${nickInfo.cleanNick}: `;
    } else {
      nickSpan.textContent = `${nick}: `;
    }
    msgDiv.appendChild(nickSpan);

    const messageSpan = document.createElement('span');
    messageSpan.innerHTML = message || rawMessage;
    msgDiv.appendChild(messageSpan);

    if (userHost && userHost !== 'unknown@unknown') {
      const hostSpan = document.createElement('span');
      hostSpan.className = 'message-userhost';
      hostSpan.textContent = ` (${userHost})`;
      msgDiv.appendChild(hostSpan);
    }
  }

  container.appendChild(msgDiv);
  container.scrollTop = container.scrollHeight;
}

function updateStatus(status, nick = '') {
  const badge = document.getElementById('statusBadge');
  const nickSpan = document.getElementById('currentNick');
  const connectBtn = document.getElementById('connectBtn');
  const disconnectBtn = document.getElementById('disconnectBtn');

  badge.className = 'status-badge';

  if (status === 'connected') {
    badge.classList.add('status-connected');
    badge.textContent = '✅ Connected';
    nickSpan.textContent = `as ${nick}`;
    connectBtn.disabled = true;
    disconnectBtn.disabled = false;
    connected = true;
    myNickname = nick;
    addChatMessage('system', '', `✅ Connected as ${nick}`);
  } else if (status === 'connecting') {
    badge.classList.add('status-connecting');
    badge.textContent = '⏳ Connecting...';
    nickSpan.textContent = 'Connecting...';
    connectBtn.disabled = true;
    disconnectBtn.disabled = true;
  } else {
    badge.classList.add('status-disconnected');
    badge.textContent = '❌ Disconnected';
    nickSpan.textContent = 'Not connected';
    connectBtn.disabled = false;
    disconnectBtn.disabled = true;
    connected = false;
    myNickname = '';
    channels = {};
    dms = {};
    currentChannel = null;
    currentDM = null;
    updateChannelList();
    updateDMList();
    updateNickList(null, []);
    addChatMessage('system', '', 'Disconnected from server');
  }
}

function updateNickList(channel, nicks) {
  const container = document.getElementById('nicklistContent');
  const userCount = document.getElementById('userCount');
  const nickCount = document.getElementById('nickCount');

  if (!channel || !nicks || nicks.length === 0) {
    container.innerHTML = '<div class="nick-item">(No users online)</div>';
    userCount.textContent = '0 users';
    nickCount.textContent = '0';
    return;
  }

  container.innerHTML = '';

  // Sort nicks: ops first, then voiced, then regular
  const sortedNicks = [...nicks].sort((a, b) => {
    const prefixOrder = { '~': 0, '&': 1, '@': 2, '%': 3, '+': 4 };
    const prefixA = a[0] in prefixOrder ? prefixOrder[a[0]] : 5;
    const prefixB = b[0] in prefixOrder ? prefixOrder[b[0]] : 5;
    return prefixA - prefixB;
  });

  sortedNicks.forEach(nick => {
    const nickInfo = parseNickPrefix(nick);
    const div = document.createElement('div');
    div.className = 'nick-item';
    div.title = nickInfo.title;

    if (nickInfo.class) {
      div.innerHTML = `
        <span class="nick-prefix ${nickInfo.class}">${nickInfo.display}</span>
        <span>${nickInfo.cleanNick}</span>
      `;
    } else {
      div.textContent = nick;
    }

    div.onclick = () => {
      const cleanNick = nickInfo.cleanNick;
      if (cleanNick !== myNickname) {
        const input = document.getElementById('messageInput');
        input.value = `/whois ${cleanNick}`;
        input.focus();
      }
    };
    container.appendChild(div);
  });

  userCount.textContent = `${nicks.length} users`;
  nickCount.textContent = nicks.length;
}

function updateChannelList() {
  const container = document.getElementById('channelList');
  const channelCount = document.getElementById('channelCount');

  if (Object.keys(channels).length === 0) {
    container.innerHTML = '<div class="channel-item"><span>Not in any channels</span></div>';
    channelCount.textContent = '0';
    return;
  }

  container.innerHTML = '';
  Object.keys(channels).forEach(channel => {
    const users = channels[channel].nicks ? channels[channel].nicks.length : 0;
    const div = document.createElement('div');
    div.className = 'channel-item';
    if (channel === currentChannel && !currentDM) {
      div.classList.add('active');
    }
    div.innerHTML = `
      <span>${channel}</span>
      <span class="channel-users">${users} users</span>
    `;
    div.onclick = () => switchToChannel(channel);
    container.appendChild(div);
  });

  channelCount.textContent = Object.keys(channels).length;
}

function updateDMList() {
  const container = document.getElementById('dmList');

  if (Object.keys(dms).length === 0) {
    container.innerHTML = '<div style="padding:8px;color:#888;font-style:italic;font-size:12px;">No private messages yet</div>';
    return;
  }

  container.innerHTML = '';
  Object.keys(dms).forEach(nick => {
    const unread = dms[nick].unread || 0;
    const div = document.createElement('div');
    div.className = 'dm-item';
    if (currentDM === nick) {
      div.classList.add('active');
      dms[nick].unread = 0;
    }
    if (unread > 0 && currentDM !== nick) {
      div.classList.add('dm-unread');
    }
    div.innerHTML = `
      <span>${nick}</span>
      ${unread > 0 && currentDM !== nick ? `<span class="dm-unread">${unread}</span>` : ''}
    `;
    div.onclick = () => switchToDM(nick);
    container.appendChild(div);
  });
}

function switchToChannel(channel) {
  if (!channel || !channels[channel]) return;

  currentChannel = channel;
  currentDM = null;
  document.getElementById('currentChannel').textContent = `${channel} 💬`;
  updateChannelList();
  updateDMList();

  const chatContent = document.getElementById('chatContent');
  chatContent.innerHTML = '';

  if (channels[channel] && channels[channel].messages) {
    channels[channel].messages.forEach(msg => {
      addChatMessage('normal', msg.sender, msg.message, msg.user_host, msg.raw_message);
    });
  }

  if (channels[channel] && channels[channel].nicks) {
    updateNickList(channel, channels[channel].nicks);
  } else {
    updateNickList(channel, []);
  }

  addChatMessage('system', '', `Switched to ${channel}`);
}

function switchToDM(nick) {
  if (!nick || !dms[nick]) return;

  currentChannel = null;
  currentDM = nick;
  document.getElementById('currentChannel').textContent = `💌 ${nick}`;
  updateChannelList();
  updateDMList();

  // Mark as read
  dms[nick].unread = 0;

  const chatContent = document.getElementById('chatContent');
  chatContent.innerHTML = '';

  if (dms[nick].messages) {
    dms[nick].messages.forEach(msg => {
      addChatMessage('pm', msg.sender, msg.message, '', msg.raw_message);
    });
  }

  updateNickList(null, []);
  addChatMessage('system', '', `Private conversation with ${nick}`);
}

function displayWhois(data) {
