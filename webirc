class IRCClient:
    def __init__(self, nick_base="webuser", ident="webuser", 
                 fullname="KampungChat Web User"):
        self.server_name = "irc.kampungchat.org"
        self.current_server = ""
        self.port = 6668

        self.ident = ident
        self.fullname = fullname
        self.nick = f"{nick_base}_{random.randint(10, 99):02d}"

        # Connection
        self.sock = None
        self.connected = False
        self.registered = False
        self.running = False
        self.registration_timeout = 30

        # Channel tracking
        self.channels = {}  # {channel: {nicks: [], messages: [], topic: ''}}
        self.nicklist_buffer = {}
        self.user_host_cache = {}
        self.private_messages = {}  # {nick: [{sender, message, time, is_self}]}
        self.current_channel = None  # Channel yang sedang aktif di view

        # Auto-join queue
        self.auto_join_channels = []
        self.join_retry_count = {}
        self.max_join_retries = 3

        # Pending requests
        self.pending_names = {}
        self.whois_data = {}  # Store WHOIS responses

        # WebSocket callback
        self.web_callback = None

    def set_web_callback(self, callback):
        self.web_callback = callback

    def emit_to_web(self, event_type, payload):
        if self.web_callback:
            self.web_callback(event_type, payload)

    def connect(self):
      """Connect ke IRC server dengan auto-retry nickname"""
      print(f"[IRC] Connecting to {self.server_name}:{self.port}...")

      try:
          self.sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
          self.sock.settimeout(30)
          self.sock.connect((self.server_name, self.port))
          self.connected = True

          # Start receive thread
          self.running = True
          self.receive_thread = threading.Thread(target=self._receive_loop)
          self.receive_thread.daemon = True
          self.receive_thread.start()

          # Registration dengan retry nickname
          time.sleep(1)

          # Generate nickname pertama
          self.nick = self._generate_nickname()
          self._send(f"NICK {self.nick}")

          time.sleep(0.5)
          self._send(f"USER {self.ident} 0 * :{self.fullname}")

          self.emit_to_web('IRC_STATUS', {'status': 'connecting', 'nick': self.nick})

          # Start registration timeout check
          threading.Thread(target=self._check_registration_timeout, daemon=True).start()

          return True

      except Exception as e:
          print(f"❌ Connection failed: {e}")
          self.emit_to_web('IRC_STATUS', {'status': 'error', 'message': str(e)})
          return False

    def _generate_nickname(self):
      """Generate random nickname"""
      import random
      import string

      # Base name
      base = "webuser"

      # Generate 4-digit random number
      random_num = random.randint(1000, 9999)

      # Atau generate random string
      random_chars = ''.join(random.choices(string.ascii_lowercase + string.digits, k=4))

      # Pilih salah satu format
      nickname = f"{base}_{random_num}"

      print(f"Generated nickname: {nickname}")
      return nickname

    def _handle_numeric(self, line, numeric):
      """Handle numeric responses termasuk NICK IN USE"""

      print(f"[NUMERIC {numeric}] {line}")

      # 433: NICKNAME IN USE
      if numeric == '433':
          print(f"⚠️ Nickname {self.nick} is already in use, generating new one...")

          # Generate new nickname
          new_nick = self._generate_nickname()
          self.nick = new_nick

          # Send new NICK command
          self._send(f"NICK {new_nick}")

          # Emit to web
          self.emit_to_web('IRC_STATUS', {
              'status': 'nick_change',
              'old_nick': self.nick,
              'new_nick': new_nick
          })
          return

      # 001: Welcome
      if numeric == '001':
          self.registered = True
          print(f"✅ Registered as {self.nick}")

          self.emit_to_web('IRC_STATUS', {
              'status': 'connected', 
              'nick': self.nick,
              'server': self.current_server or self.server_name
          })

          self._process_auto_join()

      # ... (rest of numeric handling tetap sama)

    def _check_registration_timeout(self):
        start_time = time.time()
        while time.time() - start_time < self.registration_timeout:
            if self.registered:
                return
            time.sleep(1)

        if not self.registered:
            print("❌ Registration timeout!")

    def _send(self, message):
        if self.sock:
            try:
                self.sock.send(f"{message}\r\n".encode('utf-8'))
                print(f"[SEND] {message}")
                return True
            except Exception as e:
                print(f"❌ Send failed: {e}")
                return False
        return False

    def _receive_loop(self):
        buffer = ""

        while self.running and self.connected:
            try:
                self.sock.settimeout(1)
                data = self.sock.recv(4096)

                if not data:
                    print("❌ Connection closed by server")
                    break

                buffer += data.decode('utf-8', errors='ignore')

                while '\r\n' in buffer:
                    line, buffer = buffer.split('\r\n', 1)
                    if line:
                        self._process_line(line)

            except socket.timeout:
                continue
            except Exception as e:
                print(f"❌ Receive error: {e}")
                break

        print("Receive loop ended")
        self.connected = False
        self.emit_to_web('IRC_STATUS', {'status': 'disconnected'})

    def _process_line(self, line):
        print(f"[RECV] {line}")

        # PING-PONG
        if line.startswith('PING :'):
            ping_token = line.split(':', 1)[1] if ':' in line else ''
            self._send(f"PONG {ping_token}")

        # NUMERIC RESPONSES
        parts = line.split(' ')
        if len(parts) > 1 and parts[1].isdigit():
            numeric = parts[1]
            self._handle_numeric(line, numeric)

        # PRIVMSG
        elif 'PRIVMSG' in line:
            self._handle_privmsg(line)

        # JOIN/PART/QUIT/NICK
        elif 'JOIN' in line:
            self._handle_join(line)
        elif 'PART' in line:
            self._handle_part(line)
        elif 'QUIT' in line:
            self._handle_quit(line)
        elif 'NICK' in line:
            self._handle_nick_change(line)
        elif 'NOTICE' in line:
            self._handle_notice(line)
        elif 'MODE' in line:
            self._handle_mode(line)

    def _handle_numeric(self, line, numeric):
        """Handle numeric responses termasuk WHOIS"""

        print(f"[NUMERIC {numeric}] {line}")

        # 001: Welcome
        if numeric == '001':
            self.registered = True
            print(f"✅ Registered as {self.nick}")

            self.emit_to_web('IRC_STATUS', {
                'status': 'connected', 
                'nick': self.nick,
                'server': self.current_server or self.server_name
            })

            self._process_auto_join()

        # 353: NAMES LIST
        elif numeric == '353':
            self._handle_names_list_fixed(line)

        # 366: END OF NAMES
        elif numeric == '366':
            self._handle_end_of_names(line)

        # 311-319, 330, 335, 344, 671: WHOIS responses
        elif numeric in ['311', '312', '317', '318', '319', '330', '335', '344', '671']:
            self._handle_whois_response(line, numeric)

        # 332: Topic
        elif numeric == '332':
            self._handle_topic(line)

        # Channel errors
        elif numeric in ['471', '473', '474', '475']:
            self._handle_channel_error(line, numeric)

    def _handle_whois_response(self, line, numeric):
        """Handle WHOIS responses"""
        try:
            parts = line.split(' ')
            if len(parts) < 4:
                return

            # Extract target nick (usually in position 3)
            target_nick = parts[3]

            if target_nick not in self.whois_data:
                self.whois_data[target_nick] = {
                    'whois': {},
                    'channels': [],
                    'server': '',
                    'idle': '',
                    'signon': '',
                    'registered': False,
                    'bot': False,
                    'secure': False,
                    'location': '',
                    'account': ''
                }

            # Parse based on numeric
            if numeric == '311':  # RPL_WHOISUSER
                # :server 311 requestor nick user host * :realname
                if len(parts) >= 7:
                    user = parts[4]
                    host = parts[5]
                    realname = ' '.join(parts[7:])[1:] if len(parts) > 7 else ""
                    self.whois_data[target_nick]['whois'] = {
                        'user': user,
                        'host': host,
                        'realname': realname
                    }

                    # Emit to web
                    self.emit_to_web('IRC_WHOIS', {
                        'nick': target_nick,
                        'type': 'whois_user',
                        'user': user,
                        'host': host,
                        'realname': realname
                    })

            elif numeric == '312':  # RPL_WHOISSERVER
                # :server 312 requestor nick server :server_info
                if len(parts) >= 5:
                    server = parts[4]
                    server_info = ' '.join(parts[5:])[1:] if len(parts) > 5 else ""
                    self.whois_data[target_nick]['server'] = f"{server} ({server_info})"

            elif numeric == '317':  # RPL_WHOISIDLE
                # :server 317 requestor nick idle signon :seconds idle, signon time
                if len(parts) >= 6:
                    idle = parts[4]
                    signon = parts[5]
                    self.whois_data[target_nick]['idle'] = idle
                    self.whois_data[target_nick]['signon'] = signon

                    # Convert Unix timestamp to readable time
                    try:
                        signon_time = datetime.fromtimestamp(int(signon))
                        idle_min = int(idle) // 60
                        self.emit_to_web('IRC_WHOIS', {
                            'nick': target_nick,
                            'type': 'whois_idle',
                            'idle_minutes': idle_min,
                            'signon_time': signon_time.strftime("%Y-%m-%d %H:%M:%S")
                        })
                    except:
                        pass

            elif numeric == '319':  # RPL_WHOISCHANNELS
                # :server 319 requestor nick :channels
                if len(parts) >= 5:
                    channels = ' '.join(parts[4:])[1:] if ':' in parts[4] else ' '.join(parts[4:])
                    self.whois_data[target_nick]['channels'] = channels.split()

            elif numeric == '330':  # RPL_WHOISACCOUNT
                # :server 330 requestor nick account :is logged in as
                if len(parts) >= 6:
                    account = parts[4]
                    self.whois_data[target_nick]['account'] = account
                    self.whois_data[target_nick]['registered'] = True

                    self.emit_to_web('IRC_WHOIS', {
                        'nick': target_nick,
                        'type': 'whois_account',
                        'account': account
                    })

            elif numeric == '307':  # RPL_WHOISREGNICK
                # :server 307 requestor nick :is a registered nick
                self.whois_data[target_nick]['registered'] = True

            elif numeric == '335':  # RPL_WHOISBOT
                # :server 335 requestor nick :is a bot
                self.whois_data[target_nick]['bot'] = True

            elif numeric == '344':  # RPL_WHOISACTUALLY
                # :server 344 requestor nick user@host :is connecting from
                if len(parts) >= 5:
                    location = ' '.join(parts[5:])[1:] if len(parts) > 5 else ""
                    self.whois_data[target_nick]['location'] = location

            elif numeric == '671':  # RPL_WHOISSECURE
                # :server 671 requestor nick :is using a secure connection
                self.whois_data[target_nick]['secure'] = True

            elif numeric == '318':  # RPL_ENDOFWHOIS
                # End of WHOIS
                self.emit_to_web('IRC_WHOIS', {
                    'nick': target_nick,
                    'type': 'whois_end',
                    'data': self.whois_data[target_nick]
                })

                # Clean up after sending
                if target_nick in self.whois_data:
                    del self.whois_data[target_nick]

        except Exception as e:
            print(f"❌ Error parsing WHOIS {numeric}: {e}")

    def _process_auto_join(self):
        if self.auto_join_channels:
            print(f"Auto-joining {len(self.auto_join_channels)} channels...")
            for channel in self.auto_join_channels[:]:
                self._join_channel_with_retry(channel)
                time.sleep(1)

    def _join_channel_with_retry(self, channel):
        if channel not in self.join_retry_count:
            self.join_retry_count[channel] = 0

        if self.join_retry_count[channel] >= self.max_join_retries:
            print(f"❌ Max retries reached for {channel}")
            return

        self.join_retry_count[channel] += 1
        print(f"Joining {channel} (attempt {self.join_retry_count[channel]})...")
        self._send(f"JOIN {channel}")

    def _handle_names_list_fixed(self, line):
        """Handle 353 dengan parsing prefix yang betul"""
        try:
            parts = line.split(' ')

            if len(parts) < 5:
                return

            channel = None
            for part in parts:
                if part.startswith('#'):
                    channel = part
                    break

            if not channel:
                return

            nicks_raw = ""
            for i in range(len(parts)):
                if parts[i].startswith(':'):
                    nicks_raw = ' '.join(parts[i:])[1:]
                    break

            if not nicks_raw:
                return

            # Initialize buffer
            if channel not in self.nicklist_buffer:
                self.nicklist_buffer[channel] = []

            # Process each nick with prefixes
            nicks_list = nicks_raw.split(' ')
            for nick in nicks_list:
                if nick and nick not in self.nicklist_buffer[channel]:
                    self.nicklist_buffer[channel].append(nick)

            print(f"[353] {channel}: Got {len(nicks_list)} nicks")

        except Exception as e:
            print(f"❌ Error parsing 353: {e}")

    def _handle_end_of_names(self, line):
        try:
            parts = line.split(' ')
            if len(parts) >= 4:
                channel = parts[3]

                print(f"[366] End of NAMES for {channel}")

                if channel in self.nicklist_buffer:
                    # Ensure channel exists
                    if channel not in self.channels:
                        self.channels[channel] = {'nicks': [], 'messages': [], 'topic': ''}

                    # Update nicklist dengan prefix yang betul
                    all_nicks = []
                    for nick in self.nicklist_buffer[channel]:
                        if nick and nick not in all_nicks:
                            all_nicks.append(nick)

                    self.channels[channel]['nicks'] = all_nicks

                    # Emit ke web
                    self.emit_to_web('IRC_NICKLIST', {
                        'channel': channel,
                        'nicks': all_nicks
                    })

                    print(f"[366] {channel}: Total {len(all_nicks)} nicks")

                    # Clear buffer
                    del self.nicklist_buffer[channel]

                    # Remove from pending
                    if channel in self.pending_names:
                        del self.pending_names[channel]

        except Exception as e:
            print(f"❌ Error parsing 366: {e}")

    def _handle_topic(self, line):
        try:
            parts = line.split(' ')
            if len(parts) >= 4:
                channel = parts[3]
                topic = ' '.join(parts[4:])[1:] if len(parts) > 4 else ""

                if channel not in self.channels:
                    self.channels[channel] = {'nicks': [], 'messages': [], 'topic': ''}

                self.channels[channel]['topic'] = topic

                self.emit_to_web('IRC_TOPIC', {
                    'channel': channel,
                    'topic': topic
                })

        except:
            pass

    def _handle_channel_error(self, line, numeric):
        try:
            parts = line.split(' ')
            if len(parts) >= 4:
                channel = parts[3]
                error_msg = ' '.join(parts[4:])[1:] if len(parts) > 4 else ""

                error_types = {
                    '471': 'Channel is full',
                    '473': 'Invite only channel',
                    '474': 'Banned from channel',
                    '475': 'Bad channel key'
                }

                error_text = error_types.get(numeric, 'Unknown error')

                self.emit_to_web('IRC_ERROR', {
                    'channel': channel,
                    'message': f'{error_text}: {error_msg}'
                })

                print(f"❌ Join error for {channel}: {error_text}")

        except:
            pass

    def _extract_user_host(self, prefix):
        if '!' in prefix and '@' in prefix:
            if prefix.startswith(':'):
                prefix = prefix[1:]
            try:
                nick_part, host_part = prefix.split('!', 1)
                user_part, host = host_part.split('@', 1)
                return f"{user_part}@{host}"
            except:
                return prefix.split('!')[-1]
        return "unknown@unknown"

    def _handle_privmsg(self, line):
        """Handle PRIVMSG untuk channel dan private messages"""
        try:
            match = re.match(r'^:([^ ]+) PRIVMSG ([^ ]+) :(.+)$', line)
            if not match:
                return

            prefix = match.group(1)
            target = match.group(2)
            raw_message = match.group(3)

            sender = prefix.split('!')[0] if '!' in prefix else prefix
            user_host = self._extract_user_host(prefix)
            self.user_host_cache[sender] = user_host

            processed_message = self._process_color_codes(raw_message)

            # Check if this is a private message (not a channel)
            if not target.startswith('#'):
                # It's a private message TO us
                if target == self.nick:
                    self._handle_private_message(sender, processed_message, raw_message)
                    return

            # Channel message
            if target.startswith('#'):
                if target not in self.channels:
                    self.channels[target] = {'nicks': [], 'messages': [], 'topic': ''}
                    print(f"Created channel entry for {target} from PRIVMSG")

                msg_entry = {
                    'sender': sender,
                    'user_host': user_host,
                    'message': processed_message,
                    'raw_message': raw_message,
                    'time': datetime.now().strftime("%I:%M:%S%p").lower(),
                    'type': 'channel'
                }

                # Simpan dalam channel history (max 1000 messages)
                if 'messages' not in self.channels[target]:
                    self.channels[target]['messages'] = []

                self.channels[target]['messages'].append(msg_entry)

                # Keep only last 1000 messages
                if len(self.channels[target]['messages']) > 1000:
                    self.channels[target]['messages'] = self.channels[target]['messages'][-1000:]

                # Emit ke web
                self.emit_to_web('IRC_MESSAGE', {
                    'type': 'channel',
                    'sender': sender,
                    'user_host': user_host,
                    'channel': target,
                    'message': processed_message,
                    'raw_message': raw_message,
                    'timestamp': datetime.now().strftime("%I:%M:%S%p").lower()
                })

                print(f"[PRIVMSG] {sender} in {target}: {raw_message[:50]}...")

        except Exception as e:
            print(f"❌ Error parsing PRIVMSG: {e}")

    def _handle_private_message(self, sender, message, raw_message):
        """Handle private/direct messages"""
        try:
            print(f"[PM] {sender} -> {self.nick}: {message}")

            # Initialize PM storage if needed
            if sender not in self.private_messages:
                self.private_messages[sender] = []

            # Store message
            pm_entry = {
                'sender': sender,
                'message': message,
                'raw_message': raw_message,
                'time': datetime.now().strftime("%I:%M:%S%p").lower(),
                'is_self': False
            }

            self.private_messages[sender].append(pm_entry)

            # Keep only last 200 messages per user
            if len(self.private_messages[sender]) > 200:
                self.private_messages[sender] = self.private_messages[sender][-200:]

            # Emit to web
            self.emit_to_web('IRC_PM', {
                'type': 'pm_received',
                'sender': sender,
                'message': message,
                'raw_message': raw_message,
                'timestamp': datetime.now().strftime("%I:%M:%S%p").lower()
            })

        except Exception as e:
            print(f"❌ Error handling PM: {e}")

    def send_private_message(self, target, message):
        """Send private message"""
        if self.send_message(target, message):
            # Store in our own PM history
            if target not in self.private_messages:
                self.private_messages[target] = []

            pm_entry = {
                'sender': self.nick,
                'message': message,
                'raw_message': message,
                'time': datetime.now().strftime("%I:%M:%S%p").lower(),
                'is_self': True
            }

            self.private_messages[target].append(pm_entry)

            # Emit to web
            self.emit_to_web('IRC_PM', {
                'type': 'pm_sent',
                'target': target,
                'message': message,
                'timestamp': datetime.now().strftime("%I:%M:%S%p").lower()
            })

            return True
        return False

    def _process_color_codes(self, text):
        if not text:
            return text

        # Replace IRC color codes
        def replace_color(match):
            if match.group(2):
                fg = match.group(1)
                bg = match.group(2)
                return f'<span class="irc-fg-{fg} irc-bg-{bg}">'
            else:
                fg = match.group(1)
                return f'<span class="irc-fg-{fg}">'

        text = re.sub(r'\x03(\d{1,2})(?:,(\d{1,2}))?', replace_color, text)
        text = text.replace('\x02', '<strong>')
        text = text.replace('\x0f', '</span></strong>')
        text = text.replace('\x16', '</span>')
        text = text.replace('\x03', '</span>')

        return text

    def _handle_join(self, line):
        try:
            print(f"[JOIN RAW] {line}")

            match = re.match(r'^:([^ ]+) JOIN :?(#[^ ]+)$', line)
            if not match:
                parts = line.split(' ')
                if len(parts) >= 3 and parts[1] == 'JOIN':
                    prefix = parts[0]
                    channel = parts[2]
                    if channel.startswith(':'):
                        channel = channel[1:]
                else:
                    return

            else:
                prefix = match.group(1)
                channel = match.group(2)

            nick = prefix.split('!')[0] if '!' in prefix else prefix
            user_host = self._extract_user_host(prefix)

            print(f"[JOIN] {nick} joined {channel} ({user_host})")

            self.user_host_cache[nick] = user_host

            if nick == self.nick:
                print(f"✅ WE joined {channel}")

                if channel not in self.channels:
                    self.channels[channel] = {'nicks': [self.nick], 'messages': [], 'topic': ''}
                    print(f"Created channel {channel} in tracking")

                self.emit_to_web('IRC_CHANNEL_ADD', {
                    'channel': channel,
                    'topic': ''
                })

                def request_names():
                    print(f"Requesting NAMES for {channel}...")
                    self._send(f"NAMES {channel}")
                    self.pending_names[channel] = time.time()

                threading.Timer(2.0, request_names).start()

                if channel in self.join_retry_count:
                    del self.join_retry_count[channel]

                if channel in self.auto_join_channels:
                    self.auto_join_channels.remove(channel)

            elif channel in self.channels:
                if nick not in self.channels[channel]['nicks']:
                    self.channels[channel]['nicks'].append(nick)
                    print(f"Added {nick} to {channel} nicks list")

            self.emit_to_web('IRC_JOIN', {
                'nick': nick,
                'user_host': user_host,
                'channel': channel,
                'timestamp': datetime.now().strftime("%I:%M:%S%p").lower()
            })

            if channel in self.channels:
                self.emit_to_web('IRC_NICKLIST', {
                    'channel': channel,
                    'nicks': self.channels[channel]['nicks']
                })

        except Exception as e:
            print(f"❌ Error in JOIN handler: {e}")

    def _handle_part(self, line):
        try:
            match = re.match(r'^:([^ ]+) PART (#[^ ]+)(?: :(.+))?$', line)
            if not match:
                return

            prefix = match.group(1)
            channel = match.group(2)
            reason = match.group(3) or ""

            nick = prefix.split('!')[0] if '!' in prefix else prefix
            user_host = self.user_host_cache.get(nick, "unknown@unknown")

            print(f"[PART] {nick} left {channel}")

            if channel in self.channels and nick in self.channels[channel].get('nicks', []):
                self.channels[channel]['nicks'].remove(nick)

            self.emit_to_web('IRC_PART', {
                'nick': nick,
                'user_host': user_host,
                'channel': channel,
                'reason': reason,
                'timestamp': datetime.now().strftime("%I:%M:%S%p").lower()
            })

            if nick == self.nick and channel in self.channels:
                print(f"WE left {channel}")
                del self.channels[channel]
                self.emit_to_web('IRC_CHANNEL_REMOVE', {'channel': channel})

            if channel in self.channels:
                self.emit_to_web('IRC_NICKLIST', {
                    'channel': channel,
                    'nicks': self.channels[channel]['nicks']
                })

        except Exception as e:
            print(f"❌ Error in PART handler: {e}")

    def _handle_quit(self, line):
        try:
            match = re.match(r'^:([^ ]+) QUIT(?: :(.+))?$', line)
            if not match:
                return

            prefix = match.group(1)
            message = match.group(2) or ""

            nick = prefix.split('!')[0] if '!' in prefix else prefix
            user_host = self._extract_user_host(prefix)

            print(f"[QUIT] {nick} quit")

            self.user_host_cache[nick] = user_host

            for channel in self.channels:
                if nick in self.channels[channel].get('nicks', []):
                    self.channels[channel]['nicks'].remove(nick)

                    self.emit_to_web('IRC_NICKLIST', {
                        'channel': channel,
                        'nicks': self.channels[channel]['nicks']
                    })

            self.emit_to_web('IRC_QUIT', {
                'nick': nick,
                'user_host': user_host,
                'message': message,
                'timestamp': datetime.now().strftime("%I:%M:%S%p").lower()
            })

        except Exception as e:
            print(f"❌ Error in QUIT handler: {e}")

    def _handle_nick_change(self, line):
        try:
            match = re.match(r'^:([^ ]+) NICK :?(.+)$', line)
            if not match:
                return

            prefix = match.group(1)
            new_nick = match.group(2)

            old_nick = prefix.split('!')[0] if '!' in prefix else prefix
            user_host = self.user_host_cache.get(old_nick, "unknown@unknown")

            print(f"[NICK] {old_nick} → {new_nick}")

            self.user_host_cache[new_nick] = user_host
            if old_nick in self.user_host_cache:
                del self.user_host_cache[old_nick]

            if old_nick == self.nick:
                self.nick = new_nick
                print(f"Our nick changed to {new_nick}")

            for channel in self.channels:
                if old_nick in self.channels[channel].get('nicks', []):
                    idx = self.channels[channel]['nicks'].index(old_nick)
                    self.channels[channel]['nicks'][idx] = new_nick

                    self.emit_to_web('IRC_NICKLIST', {
                        'channel': channel,
                        'nicks': self.channels[channel]['nicks']
                    })

            self.emit_to_web('IRC_NICK_CHANGE', {
                'old_nick': old_nick,
                'new_nick': new_nick,
                'user_host': user_host,
                'timestamp': datetime.now().strftime("%I:%M:%S%p").lower()
            })

        except Exception as e:
            print(f"❌ Error in NICK handler: {e}")

    def _handle_notice(self, line):
        print(f"[NOTICE] {line}")

    def _handle_mode(self, line):
        print(f"[MODE] {line}")

    # PUBLIC METHODS
    def send_message(self, target, message):
        return self._send(f"PRIVMSG {target} :{message}")

    def join_channel(self, channel):
        if not channel.startswith('#'):
            channel = f"#{channel}"

        print(f"🚀 Joining channel: {channel}")

        if not self.registered:
            print(f"Not registered yet, queuing {channel}")
            if channel not in self.auto_join_channels:
                self.auto_join_channels.append(channel)
            return True

        return self._join_channel_with_retry(channel)

    def part_channel(self, channel, message=""):
        if message:
            return self._send(f"PART {channel} :{message}")
        else:
            return self._send(f"PART {channel}")

    def change_nick(self, new_nick):
        return self._send(f"NICK {new_nick}")

    def whois(self, nick):
        """Send WHOIS command"""
        return self._send(f"WHOIS {nick}")

    def get_channels(self):
        return list(self.channels.keys())

    def get_channel_info(self, channel):
        return self.channels.get(channel)

    def get_pm_history(self, nick):
        """Get PM history with a user"""
        return self.private_messages.get(nick, [])

    def set_current_channel(self, channel):
        """Set which channel is currently active in view"""
        self.current_channel = channel

    def disconnect(self):
        self.running = False
        self.connected = False

        if self.sock:
            try:
                self._send("QUIT :KampungChat Web")
                time.sleep(0.5)
                self.sock.close()
            except:
                pass

        self.emit_to_web('IRC_STATUS', {'status': 'disconnected'})
        print("IRC Client disconnected")

