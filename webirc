// ====== SOCKET.IO HANDLERS ======
function connectSocket() {
  if (socket && socket.connected) {
    return;
  }

  socket = io();

  socket.on('connect', () => {
    console.log('WebSocket connected');
    addChatMessage('system', '', 'Connected to WebSocket server');
  });

  socket.on('irc_event', (data) => {
    console.log('IRC Event:', data.type);
    handleIrcEvent(data.type, data.payload);
  });

  socket.on('disconnect', () => {
    console.log('WebSocket disconnected');
    updateStatus('disconnected');
  });
}

function handleIrcEvent(type, payload) {
  switch(type) {
    case 'IRC_STATUS':
      if (payload.status === 'connected') {
        updateStatus('connected', payload.nick);
      } else if (payload.status === 'connecting') {
        updateStatus('connecting');
      } else if (payload.status === 'disconnected') {
        updateStatus('disconnected');
      } else if (payload.status === 'error') {
        addChatMessage('system', '', `❌ Error: ${payload.message}`);
      }
      break;

    case 'IRC_MESSAGE':
      if (payload.type === 'channel') {
        const channel = payload.channel;
        if (!channels[channel]) {
          channels[channel] = { nicks: [], messages: [], topic: '' };
        }

        const msg = {
          sender: payload.sender,
          user_host: payload.user_host,
          message: payload.message,
          raw_message: payload.raw_message,
          time: payload.timestamp
        };

        if (!channels[channel].messages) channels[channel].messages = [];
        channels[channel].messages.push(msg);

        if (channel === currentChannel && !currentDM) {
          addChatMessage('normal', payload.sender, payload.message, payload.user_host, payload.raw_message);
        }
      }
      break;

    case 'IRC_PM':
      if (payload.type === 'pm_received') {
        const sender = payload.sender;
        if (!dms[sender]) {
          dms[sender] = { messages: [], unread: 0 };
        }

        const msg = {
          sender: sender,
          message: payload.message,
          raw_message: payload.raw_message,
          time: payload.timestamp,
          is_self: false
        };

        dms[sender].messages.push(msg);

        if (currentDM === sender) {
          addChatMessage('pm', sender, payload.message, '', payload.raw_message);
        } else {
          dms[sender].unread = (dms[sender].unread || 0) + 1;
          updateDMList();
        }
      } else if (payload.type === 'pm_sent') {
        const target = payload.target;
        if (!dms[target]) {
          dms[target] = { messages: [], unread: 0 };
        }

        const msg = {
          sender: myNickname,
          message: payload.message,
          raw_message: payload.message,
          time: payload.timestamp,
          is_self: true
        };

        dms[target].messages.push(msg);

        if (currentDM === target) {
          addChatMessage('pm', myNickname, payload.message);
        }
      }
      break;

    case 'IRC_JOIN':
      const joinChannel = payload.channel;
      if (channels[joinChannel]) {
        if (!channels[joinChannel].nicks.includes(payload.nick)) {
          channels[joinChannel].nicks.push(payload.nick);
        }
        if (joinChannel === currentChannel && !currentDM) {
          addChatMessage('join', payload.nick, '', payload.user_host);
        }
      }
      break;

    case 'IRC_PART':
      const partChannel = payload.channel;
      if (channels[partChannel]) {
        const idx = channels[partChannel].nicks.indexOf(payload.nick);
        if (idx > -1) {
          channels[partChannel].nicks.splice(idx, 1);
        }
        if (partChannel === currentChannel && !currentDM) {
          addChatMessage('part', payload.nick, '', payload.user_host);
        }
      }
      break;

    case 'IRC_QUIT':
      Object.keys(channels).forEach(channel => {
        const idx = channels[channel].nicks.indexOf(payload.nick);
        if (idx > -1) {
          channels[channel].nicks.splice(idx, 1);
          if (channel === currentChannel && !currentDM) {
            addChatMessage('quit', payload.nick, payload.message || '', payload.user_host);
          }
        }
      });
      break;

    case 'IRC_NICK_CHANGE':
      Object.keys(channels).forEach(channel => {
        const idx = channels[channel].nicks.indexOf(payload.old_nick);
        if (idx > -1) {
          channels[channel].nicks[idx] = payload.new_nick;
        }
      });

      if (payload.old_nick === myNickname) {
        myNickname = payload.new_nick;
      }

      addChatMessage('system', '', `${payload.old_nick} is now known as ${payload.new_nick}`);
      break;

    case 'IRC_CHANNEL_ADD':
      if (!channels[payload.channel]) {
        channels[payload.channel] = { nicks: [myNickname], messages: [], topic: payload.topic || '' };
        updateChannelList();

        if (!currentChannel && !currentDM) {
          switchToChannel(payload.channel);
        } else {
          addChatMessage('system', '', `✅ Joined ${payload.channel}`);
        }
      }
      break;

    case 'IRC_NICKLIST':
      if (!channels[payload.channel]) {
        channels[payload.channel] = { nicks: [], messages: [], topic: '' };
      }

      channels[payload.channel].nicks = payload.nicks;
      updateChannelList();

      if (payload.channel === currentChannel && !currentDM) {
        updateNickList(payload.channel, payload.nicks);
      }
      break;

    case 'IRC_TOPIC':
      if (channels[payload.channel]) {
        channels[payload.channel].topic = payload.topic;
        if (payload.channel === currentChannel && !currentDM) {
          addChatMessage('system', '', `Topic: ${payload.topic}`);
        }
      }
      break;

    case 'IRC_WHOIS':
      displayWhois(payload);
      break;

    case 'IRC_ERROR':
      addChatMessage('system', '', `❌ ${payload.message}`);
      break;
  }
}

// ====== UI FUNCTIONS ======
function connectIRC() {
  if (connected) {
    addChatMessage('system', '', 'Already connected!');
    return;
  }

  connectSocket();
  updateStatus('connecting');
  addChatMessage('system', '', 'Connecting to IRC server...');

  fetch('/api/irc/connect', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' }
  })
  .then(response => response.json())
  .then(data => {
    if (data.status === 'ok') {
      addChatMessage('system', '', 'IRC connection initiated...');
    }
  })
  .catch(error => {
    addChatMessage('system', '', `Connection error: ${error}`);
    updateStatus('disconnected');
  });
}

function disconnectIRC() {
  if (!connected) return;

  fetch('/api/irc/disconnect', { method: 'POST' })
  .then(() => {
    updateStatus('disconnected');
  });
}

function sendMessage() {
  const input = document.getElementById('messageInput');
  const text = input.value.trim();

  if (!text) return;

  if (!connected) {
    addChatMessage('system', '', 'Please connect first!');
    input.value = '';
    return;
  }

  if (text.startsWith('/')) {
    const cmd = text.substring(1);
    if (cmd.toLowerCase().startsWith('msg ') || cmd.toLowerCase().startsWith('privmsg ')) {
      const parts = cmd.split(' ');
      if (parts.length >= 3) {
        const target = parts[1];
        const message = parts.slice(2).join(' ');
        fetch('/api/irc/pm', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target: target, message: message })
        });

        addChatMessage('pm', myNickname, message);
        input.value = '';
        return;
      }
    }

    fetch('/api/irc/command', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ command: text })
    })
    .then(response => response.json())
    .then(data => {
      if (data.status === 'sent') {
        addChatMessage('system', '', `Command sent: ${text}`);
      }
    });
  } else {
    if (currentDM) {
      // Send private message
      fetch('/api/irc/pm', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ target: currentDM, message: text })
      });

      addChatMessage('pm', myNickname, text);
    } else if (currentChannel) {
      // Send channel message
      fetch('/api/irc/message', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          target: currentChannel, 
          message: text 
        })
      });

      addChatMessage('me', myNickname, text);
    } else {
      addChatMessage('system', '', 'Join a channel or start a DM first!');
    }
  }

  input.value = '';
  input.focus();
}

function joinChannel() {
  const channel = prompt('Enter channel name (e.g., #kampung):');
  if (channel) {
    doJoinChannel(channel);
  }
}

function quickJoin() {
  const input = document.getElementById('joinChannelInput');
  const channel = input.value.trim();

  if (!channel) return;

  doJoinChannel(channel);
  input.value = '';
}

function doJoinChannel(channel) {
  if (!channel.startsWith('#')) {
    channel = '#' + channel;
  }

  addChatMessage('system', '', `Joining ${channel}...`);

  fetch('/api/irc/command', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ command: `/join ${channel}` })
  });
}

function leaveChannel() {
  if (currentChannel) {
    fetch('/api/irc/command', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ command: `/part ${currentChannel}` })
    });
    addChatMessage('system', '', `Leaving ${currentChannel}...`);
  }
}

function startDM() {
  const input = document.getElementById('dmInput');
  const nick = input.value.trim();

  if (!nick) return;

  if (nick === myNickname) {
    addChatMessage('system', '', 'Cannot start DM with yourself!');
    return;
  }

  switchToDM(nick);
  input.value = '';
  document.getElementById('messageInput').focus();
}

