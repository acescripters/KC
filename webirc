@app.route('/')
def index():
    return render_template_string(HTML_TEMPLATE)

@app.route('/api/irc/connect', methods=['POST'])
def api_irc_connect():
    global irc_client, irc_thread

    if irc_client and irc_client.connected:
        irc_client.disconnect()
        time.sleep(1)

    irc_client = IRCClient()

    def web_callback(event_type, payload):
        socketio.emit('irc_event', {
            'type': event_type,
            'payload': payload
        })

    irc_client.set_web_callback(web_callback)

    def connect_thread():
        irc_client.connect()
        while irc_client.connected:
            time.sleep(1)

    irc_thread = threading.Thread(target=connect_thread)
    irc_thread.daemon = True
    irc_thread.start()

    return jsonify({'status': 'ok', 'message': 'IRC connection started'})

@app.route('/api/irc/disconnect', methods=['POST'])
def api_irc_disconnect():
    global irc_client

    if irc_client and irc_client.connected:
        irc_client.disconnect()
        return jsonify({'status': 'ok', 'message': 'Disconnected'})

    return jsonify({'status': 'error', 'message': 'Not connected'})

@app.route('/api/irc/command', methods=['POST'])
def api_irc_command():
    global irc_client

    if not irc_client or not irc_client.connected:
        return jsonify({'status': 'error', 'message': 'Not connected to IRC'}), 400

    data = request.json
    command = data.get('command', '').strip()

    print(f"[API] Command: {command}")

    if command.startswith('/'):
        cmd_parts = command[1:].split(' ', 1)
        cmd = cmd_parts[0].lower()
        args = cmd_parts[1] if len(cmd_parts) > 1 else ""

        if cmd == 'nick' and args:
            irc_client.change_nick(args)
        elif cmd == 'join' and args:
            irc_client.join_channel(args)
        elif cmd == 'part':
            channel = args if args else '#general'
            irc_client.part_channel(channel)
        elif cmd == 'whois' and args:
            irc_client.whois(args)
        elif cmd == 'names' and args:
            irc_client._send(f"NAMES {args}")
        elif cmd == 'quit':
            irc_client.disconnect()
        else:
            irc_client._send(command[1:])
    else:
        if irc_client.channels:
            first_channel = list(irc_client.channels.keys())[0]
            irc_client.send_message(first_channel, command)
        else:
            irc_client.send_message('#general', command)

    return jsonify({'status': 'sent', 'command': command})

